---
import GuideLayout from "./GuideLayout.astro";
import {learningGuides} from "../learningGuides";
const { title, description, summary, relatedSlugs = [], godotSource, fpeHeading = "The Folded Paper Engine path" } = Astro.props as {
  title: string; description: string; summary: string; relatedSlugs?: string[]; godotSource?: {label: string; href: string}; fpeHeading?: string;
};
const currentSlug = Astro.url.pathname.split("/").pop()?.replace(/\.html$/, "");
const currentGuide = learningGuides.find((guide) => guide.slug === currentSlug);
const relatedGuides = relatedSlugs.map((slug) => learningGuides.find((guide) => guide.slug === slug)).filter((guide) => guide !== undefined);
const structuredData = { "@context": "https://schema.org", "@type": "TechArticle", headline: title, description,
  author: {"@type": "Organization", name: "Papercraft Games"}, publisher: {"@type": "Organization", name: "Papercraft Games"},
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site), proficiencyLevel: "Beginner to intermediate" };
---
<GuideLayout title={title} description={description} structuredData={[structuredData]}>
    <Fragment slot="head"><link rel="stylesheet" href="/assets/css/learning-guides.css"/></Fragment>
    <article class="learning-guide">
        <header class="learning-guide-hero"><nav aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/guides.html">Guides</a></nav><h1>{title}</h1><p>{summary}</p></header>
        <div class="learning-guide-body">
            {currentGuide?.path === "artist" && <aside class="guide-summary"><strong>New to FPE?</strong> First install the <a href="/blender-panel-docs.html">FPE Blender addon</a> and the <a href="/godot-feature-docs.html">FPE Godot addon</a>. Prefer video? Watch <a href="https://www.youtube.com/watch?v=41J92UUPx5M&list=PLM1XlwxBilobr6XVs-7H6O_mMXAiHZEcz" target="_blank" rel="noopener noreferrer">Set Up Blender</a>, then <a href="https://www.youtube.com/watch?v=YRTf65f2L3g&list=PLM1XlwxBilobr6XVs-7H6O_mMXAiHZEcz" target="_blank" rel="noopener noreferrer">Set Up Godot</a>.</aside>}
            <slot/>
            <aside class="fpe-path"><h2>{fpeHeading}</h2><slot name="fpe"/><div class="guide-actions"><a class="button small" href="/#download">Download FPE</a><a href="/guides.html">Browse all FPE guides and references</a></div></aside>
            {godotSource && <p class="source-note">Godot reference: <a href={godotSource.href} target="_blank" rel="noopener noreferrer">{godotSource.label}</a></p>}
            {relatedGuides.length > 0 && <nav class="related-guides" aria-labelledby="related-guides-title"><h2 id="related-guides-title">Keep building</h2><ul>{relatedGuides.map((guide) => <li><a href={`/guides/${guide.slug}.html`}>{guide.title}</a></li>)}</ul></nav>}
        </div>
    </article>
</GuideLayout>
